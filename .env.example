# ==========================================================
# 🔑 AI Provider API Keys (Zero Cost / Free Tiers)
# ==========================================================
# Groq API Key (Get 100% free key at https://console.groq.com/keys - 500+ tok/s)
GROQ_API_KEY=

# Google Gemini API Key (Get 100% free key at https://aistudio.google.com/apikey - 1,500 req/day)
GEMINI_API_KEY=

# Cerebras Cloud API Key (Get free key at https://cloud.cerebras.ai - 1,800+ tok/s)
CEREBRAS_API_KEY=

# OpenRouter API Key (Optional free tier at https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# ==========================================================
# 🛡️ Security Access Boundary & Abuse Prevention
# ==========================================================
# Environment mode: 'development' (default) or 'production'
# In 'development', local requests bypass token checks for zero-friction testing.
# In 'production', APP_API_TOKEN is strictly required to protect server-side provider keys.
NODE_ENV=development

# Lightweight authentication token for production deployments.
# Required for /api/chat and /api/fetch-url when running in production.
# Provide via 'x-app-token' header, request body 'appToken', or in Settings ⚙️ modal.
APP_API_TOKEN=

# Configurable CORS Allowed Origins (comma-separated list).
# In production, cross-origin requests from origins not listed here are blocked (HTTP 403).
# Example: https://rorogpt.uk,https://rorogpt.vercel.app
ALLOWED_ORIGINS=

# ==========================================================
# ⏱️ Per-IP Rate Limiting & Quotas (Sliding Window)
# ==========================================================
# Window duration in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Max chat requests allowed per IP per window (default: 30)
RATE_LIMIT_MAX_CHAT=30

# Max URL fetch requests allowed per IP per window (default: 20)
RATE_LIMIT_MAX_FETCH=20

# ==========================================================
# ⚙️ Server Configuration
# ==========================================================
PORT=3000
DEFAULT_MODEL=qwen/qwen3.8-27b
